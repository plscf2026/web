# ============================================================================
# POLICE LINES SCHOOL & COLLEGE, FARIDPUR - REUNION PLATFORM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# IMPORTANT: Never commit actual passwords or secret keys to version control.
# Copy this file to .env.local for local development.
# ============================================================================

# Supabase Backend Configuration (Publishable / Anon Client Keys)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id_here"
VITE_SUPABASE_URL="https://your_supabase_project_id_here.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_publishable_anon_key_here"

# Supabase Server Keys (Server / Edge Functions only - DO NOT prefix with VITE_)
SUPABASE_URL="https://your_supabase_project_id_here.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key_here"
SUPABASE_SECRET_KEY="your_supabase_secret_service_role_key_here"
SUPABASE_JWKS_URL="https://your_supabase_project_id_here.supabase.co/auth/v1/.well-known/jwks.json"

# Database Connection (Direct and Pooler Strings - NEVER expose in client code)
DATABASE_URL="postgresql://postgres.[project-id]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-id]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# PayStation Payment Gateway (Client Configuration)
# Note: Merchant passwords MUST NEVER be stored in VITE frontend variables!
# Server secrets (PAYSTATION_PASSWORD, PAYMENT_SIGNING_SECRET) are stored in Supabase Edge Secrets.
VITE_PAYSTATION_MERCHANT_ID="104-1653730183"
VITE_PAYSTATION_ENV="sandbox"

# Security & Testing Flags
VITE_ENABLE_TEST_BYPASS="false"
